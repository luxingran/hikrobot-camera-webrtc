        "width": 1920,
        "height": 1080
      }
    },
    "gige_top": {
      "serial": "YOUR_GIGE_CAMERA_SERIAL",
      "transport": "GigE",
      "ip": "192.168.1.100",
      "pixel_format": "BayerGB8",
      "stream": {
        "width": 1920,
        "height": 1080
      }
    }
  }
}
